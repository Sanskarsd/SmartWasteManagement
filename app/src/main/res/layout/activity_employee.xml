<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/employee"
android:layout_width="match_parent"
android:layout_height="match_parent"


tools:openDrawer="end"
tools:context=".Employee_Activity">

<!-- Main content layout -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <!-- Toolbar or Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/maincolor"
        android:padding="10dp">

        <!-- Logo Image -->
        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/applogo"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="15dp"
            android:layout_centerVertical="true" />

        <!-- TextView -->
        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Waste, Smart Future"
            android:textColor="@color/textcolor"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_toRightOf="@id/logo_image"
            android:layout_marginStart="25dp"
            android:layout_centerVertical="true" />

        <ImageButton
            android:id="@+id/adduser"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/adduser"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="15dp"
            android:layout_centerVertical="true" />



    </RelativeLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/viewPager22" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/bottomNav2"
        app:menu="@menu/bottom_employee"
        android:background="#95C7FBE3" />
</LinearLayout>


</androidx.drawerlayout.widget.DrawerLayout>
